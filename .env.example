# ==============================================================================
# CSAT Survey Application - Docker Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the Docker Compose cluster:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials into source control.
# ==============================================================================

# ── 1. Application Host & Port Settings ───────────────────────────────────────
# The published HTTP port on the host machine for the frontend container
FRONTEND_PORT=80
# Publicly accessible base URL for the frontend application
FRONTEND_URL=http://localhost

# ── 2. PostgreSQL Database Configuration ───────────────────────────────────────
# Credentials for the dedicated internal PostgreSQL container ('db')
POSTGRES_DB=csat_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword_change_in_production
POSTGRES_PORT=5432

# Backend database connection string (points to the 'db' container service name)
DATABASE_URL=postgresql://postgres:postgrespassword_change_in_production@db:5432/csat_db

# ── 3. JWT Authentication & Security ──────────────────────────────────────────
# Secret key used to sign session JWTs (generate a 64+ char random hex string in prod)
JWT_SECRET=replace-with-a-secure-random-32-plus-character-secret-key-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── 4. Initial Seed Accounts (Maker-Checker Workflow) ─────────────────────────
SEED_ADMIN_EMAIL=admin@csat.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_REVIEWER_EMAIL=reviewer@csat.local
SEED_REVIEWER_PASSWORD=ReviewerPassword123!

# ── 5. Email & SMTP Configuration (Survey Invites & Automated Reminders) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PMO CSAT Evaluation Team
SMTP_TLS=True

# ── 6. Microsoft Entra ID / Azure AD SSO (Optional) ───────────────────────────
# Keep VITE_SSO_ENABLED=false until tenant App Registration is approved
VITE_SSO_ENABLED=false
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
AAD_TENANT_ID=
AAD_REDIRECT_URI=http://localhost/auth/callback

# ── 7. Frontend Build Settings ────────────────────────────────────────────────
# In production, Nginx proxies /api to backend:8000, so relative '/api' is used
VITE_API_URL=/api
