# PMO CSAT Frontend Environment Variables
# Vite: all vars must be prefixed with VITE_
 
# Backend API URL
VITE_API_URL=http://127.0.0.1:8000/api
 
# Microsoft Azure AD / Entra ID - get these from Azure portal App Registration
VITE_AAD_CLIENT_ID=your-azure-client-id-here
VITE_AAD_TENANT_ID=your-azure-tenant-id-here
VITE_AAD_REDIRECT_URI=http://localhost:5173/auth/callback