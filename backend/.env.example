# ==========================================================
# CSAT - Backend Configuration
# ==========================================================

# Database URL (PostgreSQL local or hosted e.g. Neon)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/csat_db

# JWT & Authentication
JWT_SECRET=super-secret-csat-jwt-signing-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Audit & Upload Directory
UPLOAD_DIR=./uploads

# Default Seed Users (Maker & Checker)
SEED_ADMIN_EMAIL=admin@csat.local
SEED_ADMIN_PASSWORD=AdminPassword123!


# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
